# ---------- Supabase ----------
# Settings > API no painel do Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# NUNCA vai para o navegador: usada só por scripts/ e pelo worker de sync
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ---------- SGP (PRD 7.1) ----------
# mock = usa fixtures de docs/sgp-samples/ | real = usa a API da Interlig
SGP_MODE=mock
SGP_BASE_URL=
SGP_TOKEN=
SGP_APP=

# ---------- SZ Chat (PRD 7.1) ----------
SZCHAT_MODE=mock
SZCHAT_BASE_URL=
SZCHAT_TOKEN=
SZCHAT_WEBHOOK_SECRET=

# ---------- Parâmetros do CRM (PRD 3.9 / 3.10) ----------
CRM_DIAS_INATIVIDADE=15
CRM_DIAS_REABERTURA=30
CRM_DIAS_RECONCILIACAO=7

# ---------- Worker / cron ----------
# Protege /api/sync; a Vercel envia "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=
